{
  "name": "camera-workspace",
  "private": true,
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\deploy\\powershell\\deploy-jetson-dev.ps1 -Action start",
    "test": "npm run test:vision && npm run test:camera-server",
    "test:vision": "powershell -NoProfile -Command \"& '.\\.venv\\Scripts\\python.exe' -m pytest -c apps/pyproject.toml tests -q\"",
    "test:camera-server": "powershell -NoProfile -Command \"& '.\\.venv\\Scripts\\python.exe' -m pytest -c services/camera-server/pyproject.toml services/camera-server/tests -q\"",
    "check": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\deploy\\powershell\\check.ps1",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\deploy\\powershell\\deploy-jetson.ps1"
  }
}
