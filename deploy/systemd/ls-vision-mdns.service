[Unit]
Description=LS-Vision production mDNS address
After=avahi-daemon.service
Wants=avahi-daemon.service

[Service]
Type=simple
User=letron
Group=letron
WorkingDirectory=/opt/ls-vision/current/app
Environment=PYTHONPATH=/opt/ls-vision/current/app/src
ExecStart=/opt/ls-vision/runtime/venv/bin/python3 -m interfaces.mdns_publisher
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
