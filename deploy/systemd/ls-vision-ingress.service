[Unit]
Description=LS-Vision and T-Box host-routing ingress

[Service]
Type=simple
User=letron
Group=letron
WorkingDirectory=/opt/ls-vision/current/app
Environment=PYTHONPATH=/opt/ls-vision/current/app/src
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ExecStart=/opt/ls-vision/runtime/venv/bin/python3 -m interfaces.host_ingress --port 80 --vision-unix-socket /run/ls-vision/api.sock --default-upstream 127.0.0.1:8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
