[Unit]
Description=LeOS MediaMTX RTSP relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=letron
Group=letron
Environment=MTX_RTSPADDRESS=:8554
Environment=MTX_PROTOCOLS=tcp
Environment=MTX_PATHS_ALL_OTHERS={}
Environment=MTX_HLSADDRESS=:8888
Environment=MTX_HLSVARIANT=mpegts
Environment=MTX_HLSSEGMENTDURATION=3s
Environment=MTX_HLSSEGMENTCOUNT=6
Environment=MTX_HLSALWAYSREMUX=yes
Environment=MTX_HLSALLOWORIGIN=*
Environment=MTX_WEBRTCADDRESS=:8889
Environment=MTX_WEBRTCALLOWORIGIN=*
ExecStart=/opt/ls-vision/runtime/bin/mediamtx /opt/ls-vision/runtime/mediamtx.conf
Restart=always
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
