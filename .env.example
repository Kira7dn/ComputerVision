# Standalone DeepStream notification credentials. Keep real values in .env.local.
# Enable notifications and channels in config/dev.yaml or production.yaml.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ZALO_BOT_TOKEN=
ZALO_CHAT_ID=

# Managed public tunnel. NGROK_URL is the reserved HTTPS origin; the token is
# a secret and must never be copied into an application config file.
NGROK_AUTHTOKEN=
NGROK_URL=https://example.ngrok.app
