# Native notification provider secrets. Recipients and public URLs belong in
# Frigate's notifications config and are intentionally not duplicated here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ZALO_BOT_TOKEN=
ZALO_CHAT_ID=

# Managed public tunnel. NGROK_URL is the reserved HTTPS origin; the token is
# a secret and must never be copied into deploy/config.yaml.
NGROK_AUTHTOKEN=
NGROK_URL=https://example.ngrok.app
